# Optional local JWT/seed secrets
JWT_SECRET=local-dev-jwt-secret
SEED_SECRET=local-dev-seed-secret

# Optional remote libSQL/Turso database for serverless deployment (defaults to local.db locally)
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Optional external API base URL for Vite frontend-only mode (leave unset to use local API)
# VITE_API_URL=
